Options -Indexes
RewriteEngine On

# If the requested filename is a real file (like setup_admin.php), serve it directly
RewriteCond %{REQUEST_FILENAME} -f
RewriteRule ^ - [L]

# Rewrite all other requests to index.php unless they are actual directories
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^ index.php [L]
